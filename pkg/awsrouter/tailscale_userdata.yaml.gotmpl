#cloud-config
# Tailscale subnet router — cloud-init BOOTSTRAP.
#
# This file is deliberately small: everything it used to do directly
# (chrony, audit, journald, sshd hardening, the tailnet join, the
# optional SSH user-certificate and opkssh sign-in) now lives in
# router-setup.sh, a single generic, version-pinned script every router
# downloads and checksum-verifies before running — see
# bootstrap.go/router-setup.sh and docs/safety.md ("The bootstrap
# split"). This file's own job is: install the packages router-setup.sh
# needs, write this router's own small per-router values and feature
# flags, then fetch, verify and run it.
#
# Template variables populated by Go: Region, AdvertiseRoutes,
# SSMAuthKeyPath, WireGuardPort, PrimaryInterface, ASGName,
# LifecycleHookName, SetupScriptURL, SetupScriptSHA256, SSHUserCA,
# OPKSSH.

# ── First-boot patching: deliberately ABSENT ─────────────────────────
# package_update/package_upgrade at first boot OOM-kills cloud-init on
# t4g.nano (512MB): the AL2023 dnf metadata+upgrade pass exceeds RAM, the
# kernel kills cloud-final, and everything downstream (package install,
# runcmd, lifecycle-hook completion) dies with it. Patching is handled by
# dnf-automatic + router-setup.sh's nightly update/reboot script instead,
# which run with the swap file below already active.

# ── Swap — dnf headroom on 512MB instances ───────────────────────────
swap:
  filename: /swapfile
  size: 1073741824
  maxsize: 1073741824

# ── Timezone ─────────────────────────────────────────────────────────
# Explicit UTC — documents intent, avoids DST ambiguity.
timezone: UTC

# ── Packages ─────────────────────────────────────────────────────────
# Declarative package installation — runs before runcmd. router-setup.sh
# itself installs nothing beyond this list (plus tailscale, from the
# repo file it writes, on the join's own critical path).
packages:
  # ISO 27001 A.8.17 — clock synchronization (defensive; AL2023 includes chrony)
  - chrony
  # ISO 27001 A.12.4 — audit logging and file integrity monitoring
  - audit
  # ISO 27001 A.8.8 — automatic security updates
  - dnf-automatic
  # Provides needs-restarting for reboot-required detection
  - dnf-utils
  # Network security — host firewall
  - firewalld
  # Debug tools — installed declaratively, non-critical
  - bind-utils
  - nmap-ncat
  - tcpdump
  - traceroute
{{- if .OPKSSH }}
  # router-setup.sh's opkssh install: checkmodule/semodule_package.
  - checkpolicy
{{- end }}

# ── Boot-time recovery hook ──────────────────────────────────────────
# bootcmd runs EVERY boot (before write_files on the first boot, where it
# no-ops). Recent AL2023 images reboot mid-first-boot to apply a SELinux
# kernel-cmdline change, SIGTERM-ing cloud-init's package/runcmd phases;
# their run-once semaphores are consumed, so the join would never happen.
# The join lives in an idempotent systemd unit (written by
# router-setup.sh) started here on every boot.
bootcmd:
  - [ sh, -c, "systemctl daemon-reload && systemctl enable --now --no-block tailscale-join.service || true" ]

# ── Configuration files ──────────────────────────────────────────────
# Written before runcmd. Everything here is either this router's own
# small values (router.env) or a small literal per-router file
# router-setup.sh stages into its final, correctly-owned location —
# never the bulk of what actually configures the router.
write_files:
  - path: /etc/tailscale-router/router.env
    permissions: "0600"
    content: |
      REGION="{{ .Region }}"
      ADVERTISE_ROUTES="{{ .AdvertiseRoutes }}"
      SSM_AUTH_KEY_PATH="{{ .SSMAuthKeyPath }}"
      WIREGUARD_PORT="{{ .WireGuardPort }}"
      PRIMARY_INTERFACE="{{ .PrimaryInterface }}"
      ASG_NAME="{{ .ASGName }}"
      LIFECYCLE_HOOK_NAME="{{ .LifecycleHookName }}"
      SSH_USER_CA="{{ if .SSHUserCA }}true{{ else }}false{{ end }}"
      OPKSSH="{{ if .OPKSSH }}true{{ else }}false{{ end }}"
{{- if .OPKSSH }}
      OPKSSH_ARTIFACT_VERSION="{{ .OPKSSH.ArtifactVersion }}"
      OPKSSH_ARTIFACT_URL="{{ .OPKSSH.ArtifactURL }}"
      OPKSSH_ARTIFACT_SHA256="{{ .OPKSSH.ArtifactSHA256 }}"
      OPKSSH_SELINUX_URL="{{ .OPKSSH.SELinuxModuleURL }}"
      OPKSSH_SELINUX_SHA256="{{ .OPKSSH.SELinuxModuleSHA256 }}"
{{- end }}
      HOST_CERT="{{ if .HostCert }}true{{ else }}false{{ end }}"
{{- if .HostCert }}
      HOST_CERT_ARTIFACT_VERSION="{{ .HostCert.ArtifactVersion }}"
      HOST_CERT_ARTIFACT_SHA256="{{ .HostCertSHA256 }}"
      HOST_CERT_ADDRESS="{{ .HostCert.Address }}"
      HOST_CERT_NAMESPACE="{{ .HostCert.Namespace }}"
      HOST_CERT_AUTH_MOUNT="{{ .HostCert.AuthMount }}"
      HOST_CERT_AUTH_ROLE="{{ .HostCert.AuthRole }}"
      HOST_CERT_SERVER_ID_HEADER="{{ .HostCert.ServerIDHeader }}"
      HOST_CERT_SSH_MOUNT="{{ .HostCert.SSHMount }}"
      HOST_CERT_SSH_ROLE="{{ .HostCert.SSHRole }}"
      HOST_CERT_PRINCIPAL_PATTERNS="{{ .HostCertPrincipalPatterns }}"
{{- end }}
{{- if .SSHUserCA }}

  # SSH user certificates only (ssh.go); router-setup.sh copies these
  # into their final /etc/ssh/... paths and writes the sshd drop-in.
  - path: /etc/tailscale-router/trusted-user-ca-keys.pub
    permissions: "0644"
    content: |
{{- range .SSHUserCA.TrustedUserCAKeys }}
      {{ . }}
{{- end }}
{{- range .SSHUserCA.Principals }}

  - path: /etc/tailscale-router/authorized_principals/{{ .User }}
    permissions: "0644"
    content: |
{{- range .Principals }}
      {{ . }}
{{- end }}
{{- end }}
{{- end }}
{{- if .OPKSSH }}

  # opkssh.go: additive OIDC sign-in — the exact /etc/opk/{providers,auth_id}
  # lines, staged; router-setup.sh installs opkssh (own steps — see its
  # header comment on why it does not run opkssh's upstream
  # install-linux.sh) then copies these into place with the ownership
  # and mode opkssh requires.
  - path: /etc/tailscale-router/opkssh-providers
    permissions: "0600"
    content: |
{{- range .OPKSSH.Providers }}
      {{ .Issuer }} {{ .ClientID }} {{ .Expiration }}
{{- end }}

  - path: /etc/tailscale-router/opkssh-auth_id
    permissions: "0600"
    content: |
{{- range .OPKSSH.AuthorizedIdentities }}
      {{ .User }} oidc:groups:{{ .Group }} {{ .Issuer }}
{{- end }}
{{- end }}
{{- if .HostCertCABundleLines }}

  # hostcert.go: the OpenBAO server's CA bundle, staged for
  # router-setup.sh to pass as openbao-hostcert's --ca-cert. Absent
  # entirely when HostCert.CABundle is empty (the OS trust store
  # alone) — router-setup.sh checks for this file, not a flag.
  - path: /etc/tailscale-router/hostcert-ca.pem
    permissions: "0644"
    content: |
{{- range .HostCertCABundleLines }}
      {{ . }}
{{- end }}
{{- end }}

# ── Runtime commands ─────────────────────────────────────────────────
runcmd:
  # Fail closed: a download failure or a checksum mismatch aborts before
  # router-setup.sh ever runs as root, leaving only this small bootstrap
  # applied (swap, timezone, packages) — never a half-verified script.
  - curl -fsSL -o /usr/local/sbin/router-setup.sh "{{ .SetupScriptURL }}"
  - |
    echo "{{ .SetupScriptSHA256 }}  /usr/local/sbin/router-setup.sh" | sha256sum -c - || { echo "router-setup checksum fail"; exit 0; }
  - chmod 0755 /usr/local/sbin/router-setup.sh
  - /usr/local/sbin/router-setup.sh || echo "router-setup fail"

  # ── Tailscale join ──────────────────────────────────────────────
  # router-setup.sh wrote the join script and its systemd unit; enabling
  # it here (as bootcmd also does on every later boot) survives the
  # AL2023 first-boot SELinux reboot the same way it always has.
  - systemctl daemon-reload
  - systemctl enable --now --no-block tailscale-join.service
