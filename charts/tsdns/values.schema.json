{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tsdns chart values",
  "description": "Strict at the top level: unknown keys are rejected so a typo fails the render instead of being silently ignored. Kubernetes passthrough fields stay open. suffix/clusterIP/resolverIP are required — the chart is meaningless without them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suffix", "clusterIP", "resolverIP"],
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicas": { "type": "integer", "minimum": 0 },
    "suffix": { "type": "string", "minLength": 1 },
    "clusterIP": { "type": "string", "minLength": 1 },
    "resolverIP": { "type": "string", "minLength": 1 },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "catchAll": { "type": "boolean" },
    "forwardZones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone", "resolver"],
        "properties": {
          "zone": { "type": "string", "minLength": 1 },
          "resolver": { "type": "string", "minLength": 1 }
        }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "resources": { "type": "object" }
  }
}
